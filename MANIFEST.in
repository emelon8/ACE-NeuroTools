include AUTHORS.md
include CHANGELOG.md
include CITATION.cff
include CODE_OF_CONDUCT.md
include CONTRIBUTING.md
include environment.yml
include conda-lock.yml
prune data
prune cache
recursive-include docs *.md
recursive-include examples *.md *.py
recursive-include notebooks *.ipynb
recursive-include ci *.json *.txt *.yml
recursive-include tests *.py
recursive-include .github/workflows *.yml
include scripts/check_coverage.py
include scripts/check_distribution.py
include scripts/ci_environment.py
include scripts/run_backend_checks.py
include scripts/smoke_installed_package.py
