{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/emelon8/experiment_analysis/schemas/aceneuro-analysis-cnmfe-v1.json",
  "title": "CNMF-E / miniscope analysis parameters",
  "description": "One experiment's miniscope analysis parameters — the canonical JSON document decided by D05 (docs/adr/0002-json-parameter-documents.md). Maps 1:1 to this experiment's analysis_parameters.csv row; keys inside 'params' are the CSV column names verbatim, typed exactly as CSVWorker.convert_data_types delivers them to the pipelines. Identity and directory columns are owned by the experiment document and pass through untouched.",
  "type": "object",
  "required": ["schema", "line_number", "params", "_csv"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "aceneuro-analysis-cnmfe-v1" },
    "line_number": { "type": "integer", "minimum": 1 },
    "id": { "type": ["string", "null"] },
    "date": { "type": ["string", "null"], "pattern": "^[0-9]{6}$" },
    "comments": { "type": ["string", "null"] },
    "params": {
      "type": "object",
      "additionalProperties": true,
      "description": "Analysis parameters keyed by CSV column name. Well-known CNMF-E keys are typed below; lab-specific extra columns are permitted.",
      "properties": {
        "indices of TTL events to delete": { "type": ["array", "null"] },
        "zero time (s)": { "type": ["number", "null"] },
        "baseline period (min)": { "type": ["number", "array", "null"] },
        "decay_time": { "type": ["number", "null"] },
        "update_background_components": { "type": ["boolean", "null"] },
        "method_deconvolution": { "type": ["string", "null"] },
        "method_init": { "type": ["string", "null"] },
        "K": { "type": ["integer", "number", "null"] },
        "gSig": { "type": ["array", "null"], "items": { "type": "number" } },
        "gSiz": { "type": ["array", "null"], "items": { "type": "number" } },
        "tsub": { "type": ["integer", "number", "null"] },
        "ssub": { "type": ["integer", "number", "null"] },
        "ssub_B": { "type": ["integer", "number", "null"] },
        "ring_size_factor": { "type": ["number", "null"] },
        "min_corr": { "type": ["number", "null"] },
        "min_pnr": { "type": ["number", "null"] },
        "normalize_init": { "type": ["boolean", "null"] },
        "center_psf": { "type": ["boolean", "null"] },
        "nb": { "type": ["integer", "number", "null"] },
        "p": { "type": ["integer", "number", "null"] },
        "del_duplicates": { "type": ["boolean", "null"] },
        "border_pix": { "type": ["integer", "number", "null"] },
        "low_rank_background": { "type": ["boolean", "string", "null"] },
        "rf": { "type": ["integer", "number", "null"] },
        "stride": { "type": ["integer", "number", "null"] },
        "only_init": { "type": ["boolean", "null"] },
        "nb_patch": { "type": ["integer", "number", "null"] },
        "min_SNR": { "type": ["number", "null"] },
        "rval_thr": { "type": ["number", "null"] },
        "use_cnn": { "type": ["boolean", "null"] },
        "merge_thr": { "type": ["number", "null"] },
        "pw_rigid": { "type": ["boolean", "null"] },
        "shifts_opencv": { "type": ["boolean", "null"] },
        "max_shifts": { "type": ["array", "number", "null"] },
        "gSig_filt": { "type": ["array", "null"] },
        "strides": { "type": ["array", "null"] },
        "overlaps": { "type": ["array", "null"] },
        "max_deviation_rigid": { "type": ["integer", "number", "null"] },
        "border_nan": { "type": ["string", "boolean", "null"] },
        "crop_coords": { "type": ["array", "null"], "items": { "type": "number" } },
        "periods of high slow wave power (s)": { "type": ["array", "null"] },
        "control periods (s)": { "type": ["array", "null"] },
        "ca_ephys_baseline_video_num": { "type": ["integer", "number", "null"] },
        "ca_ephys_slow_wave_video_num": { "type": ["integer", "number", "null"] },
        "ca_ephys_burst_suppression_video_num": { "type": ["integer", "number", "null"] }
      }
    },
    "_csv": {
      "type": "object",
      "required": ["columns", "raw"],
      "additionalProperties": false,
      "description": "Verbatim CSV passthrough: column order and raw cell strings from the source row, preserved so writeback is non-destructive for unknown lab-specific columns (D05 export-coverage rule).",
      "properties": {
        "columns": { "type": "array", "items": { "type": "string" } },
        "raw": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
